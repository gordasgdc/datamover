<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Permite dotnet build sa rezolve TFM-ul windows si de pe macOS -
         vezi acelasi tipar in GDCVaultWin/GDCPluginManagerWin. Nu
         inlocuieste un build/test real pe Windows (XAML->BAML). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DataMover.Client</RootNamespace>
    <AssemblyName>DataMover</AssemblyName>
    <!-- OBLIGATORIU pentru QuestPDF (raport PDF) - raportat de Cristi
         2026-08-28 (TypeInitializationException, DllNotFoundException
         'QuestPdfSkia'): pe Windows ARM64 (Parallels pe Mac Apple
         Silicon), "Any CPU" (implicit) ruleaza procesul ca win-arm64, iar
         QuestPDF NU are build nativ pentru arhitectura asta (doar
         win-x86/win-x64/linux-*/osx-*) - mesajul chiar cere explicit
         "Platform target = x64 sau x86, nu Any CPU". Fortand x64, Windows
         11 ARM ruleaza aplicatia prin emulatie x64 (nativa, suportata de
         OS) - functioneaza atat pe Windows x64 real cat si pe ARM64. -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Rescriere WPF/Fluent (2026-08-28) - inlocuieste treptat ui/windows
         (Python/Tkinter). Versiune sincronizata cu varianta Mac/Python -
         vezi Regula 14 din CLAUDE.md. -->
    <Version>2.12.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <!-- [2026-09-06] Ghidurile PDF (RO/EN/ES, deja existente in docs/guides/
       pentru Mac) - clientul WPF nu avea NICIUN acces la ele. App-ul e
       RO-only azi (fara selector de limba), deci butonul "Ghid" deschide
       mereu varianta RO - celelalte doua raman bundle-uite pentru ziua in
       care se adauga un selector de limba (Regula 30 - nu se lasa pe
       jumatate facut). -->
  <ItemGroup>
    <Content Include="..\..\docs\guides\DataMover_Ghid_RO.pdf" Link="DataMover_Ghid_RO.pdf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\guides\DataMover_Guide_EN.pdf" Link="DataMover_Guide_EN.pdf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\guides\DataMover_Guia_ES.pdf" Link="DataMover_Guia_ES.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataMover.Core\DataMover.Core.csproj" />
  </ItemGroup>

</Project>
