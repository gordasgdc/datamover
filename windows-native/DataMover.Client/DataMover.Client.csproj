<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Permite dotnet build sa rezolve TFM-ul windows si de pe macOS -
         vezi acelasi tipar in GDCVaultWin/GDCPluginManagerWin. Nu
         inlocuieste un build/test real pe Windows (XAML->BAML). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DataMover.Client</RootNamespace>
    <AssemblyName>DataMover</AssemblyName>
    <!-- OBLIGATORIU pentru QuestPDF (raport PDF) - raportat de Cristi
         2026-08-28 (TypeInitializationException, DllNotFoundException
         'QuestPdfSkia'): pe Windows ARM64 (Parallels pe Mac Apple
         Silicon), "Any CPU" (implicit) ruleaza procesul ca win-arm64, iar
         QuestPDF NU are build nativ pentru arhitectura asta (doar
         win-x86/win-x64/linux-*/osx-*) - mesajul chiar cere explicit
         "Platform target = x64 sau x86, nu Any CPU". Fortand x64, Windows
         11 ARM ruleaza aplicatia prin emulatie x64 (nativa, suportata de
         OS) - functioneaza atat pe Windows x64 real cat si pe ARM64. -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Rescriere WPF/Fluent (2026-08-28) - inlocuieste treptat ui/windows
         (Python/Tkinter). Versiune sincronizata cu varianta Mac/Python -
         vezi Regula 14 din CLAUDE.md. -->
    <Version>2.8.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataMover.Core\DataMover.Core.csproj" />
  </ItemGroup>

</Project>
