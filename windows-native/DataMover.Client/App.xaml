<Application x:Class="DataMover.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ControlsDictionary />
                <ui:ThemesDictionary Theme="Dark" />
                <!-- DUPĂ dicționarele WPF-UI, niciodată înainte: aliasurile de
                     mai jos se leagă prin DynamicResource de culorile definite
                     acolo, iar stilurile implicite trebuie să le poată
                     suprascrie pe cele din ControlsDictionary. -->
                <ResourceDictionary Source="Styles/ThemeAliases.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
