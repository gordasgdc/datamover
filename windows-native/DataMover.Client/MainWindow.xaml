<ui:FluentWindow x:Class="DataMover.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="DataMover" Height="720" Width="1180" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <!--
      Rescriere WPF/Fluent (2026-08-28), la cererea explicita a lui Cristi
      dupa ce a vazut design-ul mult mai modern al variantei Mac (SwiftUI) -
      inlocuieste treptat ui/windows/app.py (Python/Tkinter, design
      "primitiv"). Structura oglindeste ContentView.swift (Mac): coloana
      Surse | zona centrala (proiect/card/optiuni/activitate) | coloana
      Destinatii, cu un footer de progres/actiuni comun. Vezi CLAUDE.md
      pentru roadmap-ul complet (ce mai lipseste fata de Mac).

      IMPORTANT: FluentWindow inlocuieste chrome-ul nativ Windows - un
      <ui:TitleBar> explicit e OBLIGATORIU, altfel fereastra ramane fixa,
      fara zona de drag/minimize/maximize/close (bug real, gasit deja pe
      GDCVaultWin - vezi Regula in CLAUDE.md-ul acelui repo).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="MainTitleBar" Grid.Row="0" Title="DataMover" />

        <!-- ===================== DISCURI DETECTATE ===================== -->
        <!-- Raportat de Cristi (2026-08-28, test real pe Windows/Parallels):
             "nu detecteaza sursele, nu se vad hard discurile, cardurile
             video" - lipsea complet, spre deosebire de Mac (grid de discuri
             in ContentView.swift). Lista se reimprospateaza periodic (vezi
             RefreshDrives), clic pe "+ Sursa"/"+ Destinatie" adauga direct
             litera de disc in lista corespunzatoare. -->
        <ui:CardExpander Grid.Row="1" Header="DISCURI DETECTATE" IsExpanded="True" Margin="16,8,16,0">
            <ItemsControl x:Name="DrivesList" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="10" Margin="0,0,8,8" Width="180">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Image Source="{Binding IconSource}" Width="24" Height="24" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding FreeSpaceText}" Foreground="Gray" FontSize="11" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="+ Sursa" Tag="{Binding Path}" Click="OnAddDriveAsSourceClicked" Margin="0,0,6,0" Padding="6,2" FontSize="11" />
                                    <Button Content="+ Destinatie" Tag="{Binding Path}" Click="OnAddDriveAsDestinationClicked" Padding="6,2" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ui:CardExpander>

        <Grid Grid.Row="2" Margin="16,8,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="200" MaxWidth="380" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="260" MinWidth="200" MaxWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- ===================== SURSE ===================== -->
            <!-- AllowDrop pe intreg panoul (nu doar pe ListView) - trage un
                 folder din Explorer oriunde in caseta Surse. Raportat lipsa
                 la testul real pe Windows (2026-08-28). -->
            <ui:CardExpander Grid.Column="0" Header="SURSE" IsExpanded="True"
                             AllowDrop="True" DragOver="OnSourcesDragOver" Drop="OnSourcesDrop">
                <StackPanel>
                    <ui:ListView x:Name="SourcesList" Height="140" Margin="0,0,0,8"
                                 AllowDrop="True" DragOver="OnSourcesDragOver" Drop="OnSourcesDrop" />
                    <ui:Button Content="Adauga sursa..." Icon="{ui:SymbolIcon FolderAdd24}" Click="OnAddSourceClicked" HorizontalAlignment="Stretch" Margin="0,0,0,4" />
                    <ui:Button Content="Elimina selectia" Click="OnRemoveSourceClicked" HorizontalAlignment="Stretch" Appearance="Secondary" />

                    <!-- [2026-09-03] COADA DE CARDURI — descarcarea mai multor
                         carduri, unul dupa altul, nesupravegheat. Pe un platou cu
                         3 camere se aduna 6-8 carduri la finalul zilei; pana acum
                         operatorul trebuia sa porneasca manual fiecare card dupa
                         ce se termina cel dinainte. Fiecare card din coada isi
                         pastreaza numele propriu, deci ajunge in propriul folder
                         la destinatie. -->
                    <Separator Margin="0,10,0,6" />
                    <TextBlock Text="COADA CARDURI" FontWeight="Bold" FontSize="11" Foreground="Gray" Margin="0,0,0,4" />
                    <ItemsControl x:Name="CardQueueList" MaxHeight="110">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Card}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <ui:Button Grid.Column="1" Content="✕" Appearance="Secondary" FontSize="10" Padding="6,2"
                                               Tag="{Binding}" Click="OnRemoveFromQueueClicked" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button Content="+ Adauga in coada" Appearance="Secondary" FontSize="11"
                               Click="OnAddToQueueClicked" HorizontalAlignment="Stretch" Margin="0,4,0,2" />
                    <ui:Button Content="Porneste coada" FontSize="11"
                               Click="OnStartQueueClicked" HorizontalAlignment="Stretch" />
                </StackPanel>
            </ui:CardExpander>

            <!-- ===================== CENTRU ===================== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ui:CardControl Icon="{ui:SymbolIcon DocumentFolder24}" Margin="0,0,0,8">
                        <ui:CardControl.Header>
                            <!-- WrapPanel (2026-08-28, responsivitate) - la o fereastra ingusta,
                                 campurile trec pe randul urmator in loc sa se taie/suprapuna
                                 peste marginea cardului (raportat de Cristi). -->
                            <WrapPanel>
                                <TextBlock Text="Proiect:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ui:TextBox x:Name="ProjectBox" Width="130" Margin="0,0,16,4" />
                                <TextBlock Text="Card:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ui:TextBox x:Name="CardBox" Width="130" Margin="0,0,0,4" />
                            </WrapPanel>
                        </ui:CardControl.Header>
                    </ui:CardControl>

                    <!-- Panou unificat "Setari copiere" (2026-08-29, parity cu popover-ul
                         Mac v2.7.1: un singur gear-icon in loc de 3 carduri mereu
                         desfasurate care ocupau tot centrul ferestrei - raportat de
                         Cristi ca aglomerare vizuala/"prea mult loc"). Controalele
                         raman EXACT aceleasi (x:Name identice), doar re-parentate
                         intr-un Popup - codebehind-ul (MainWindow.xaml.cs) nu s-a
                         schimbat. -->
                    <ui:Button x:Name="SettingsGearButton" Content="Setari copiere" Icon="{ui:SymbolIcon Settings24}"
                               Click="OnToggleSettingsPopup" HorizontalAlignment="Left" Margin="0,0,0,8" />
                    <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsGearButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12" Width="360" MaxHeight="480">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Optiuni de copiere" FontWeight="Bold" Margin="0,0,0,6" />
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBlock Text="Model verificare:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                        <ComboBox x:Name="VerificationCombo" Width="160" Margin="0,0,0,4" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBlock Text="Excluderi:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                        <ui:TextBox x:Name="ExclusionsBox" Width="260" Text=".DS_Store, .tmp, Thumbs.db" Margin="0,0,0,4" />
                                    </WrapPanel>
                                    <CheckBox x:Name="SkipExistingCheck" Content="Sari peste fisiere identice deja existente" Margin="0,0,0,4" />

                                    <!-- [2026-09-03] MHL + reincercare + ejectare + pornire
                                         automata. Explicatia de sub fiecare bifa nu e decor:
                                         un DIT stie ce e un MHL, dar un videograf care descarca
                                         singur cardul nu, iar bifa fara context ar fi lasata pe
                                         implicit fara sa inteleaga ce livreaza mai departe. -->
                                    <CheckBox x:Name="GenerateMhlCheck" Content="Genereaza fisier MHL (Media Hash List)" Checked="OnToggleSettingChanged" Unchecked="OnToggleSettingChanged" />
                                    <TextBlock Text="Certificat de integritate citit de Silverstack, YoYotta, ShotPut Pro si casele de post — se scrie langa datele copiate. Necesita xxHash64, MD5 sau SHA-1."
                                               Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="24,0,0,6" />
                                    <CheckBox x:Name="RetryFailedCheck" Content="Reincearca automat fisierele esuate" Checked="OnToggleSettingChanged" Unchecked="OnToggleSettingChanged" />
                                    <TextBlock Text="La finalul transferului, fisierele cu eroare sau nepotrivire se copiaza inca o data — majoritatea esecurilor de pe platou sunt tranzitorii (card miscat, cablu, disc adormit)."
                                               Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="24,0,0,6" />
                                    <CheckBox x:Name="EjectWhenDoneCheck" Content="Ejecteaza cardul automat la final" Checked="OnToggleSettingChanged" Unchecked="OnToggleSettingChanged" />
                                    <TextBlock Text="Doar daca transferul s-a terminat fara nicio eroare. Ejectarea cere drepturi de Administrator."
                                               Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="24,0,0,6" />
                                    <CheckBox x:Name="AutoStartOnCardCheck" Content="Porneste automat la introducerea unui card" Checked="OnToggleSettingChanged" Unchecked="OnToggleSettingChanged" />
                                    <TextBlock Text="Cardul intra direct in coada si descarcarea incepe singura. Necesita cel putin o destinatie aleasa."
                                               Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="24,0,0,12" />

                                    <!-- [2026-09-03] Metadate de productie + sablon de denumire.
                                         Toate campurile sunt OPTIONALE — un transfer fara ele
                                         functioneaza exact ca inainte. Completate, apar in
                                         antetul rapoartelor PDF/HTML si (unde userul le pune in
                                         sablon) in numele folderelor. -->
                                    <TextBlock Text="Productie &amp; rapoarte" FontWeight="Bold" Margin="0,0,0,6" />
                                    <WrapPanel Margin="0,0,0,6">
                                        <TextBlock Text="Client:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                        <ui:TextBox x:Name="ClientBox" Width="120" Margin="0,0,12,4" TextChanged="OnProductionMetaChanged" />
                                        <TextBlock Text="Operator / DIT:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                        <ui:TextBox x:Name="OperatorBox" Width="120" Margin="0,0,0,4" TextChanged="OnProductionMetaChanged" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,6">
                                        <TextBlock Text="Camera:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                        <ui:TextBox x:Name="CameraBox" Width="120" Margin="0,0,0,4" TextChanged="OnProductionMetaChanged" />
                                    </WrapPanel>
                                    <ui:TextBox x:Name="NotesBox" PlaceholderText="Note de filmare (apar in raport)" AcceptsReturn="True" Height="46" Margin="0,0,0,6" TextChanged="OnProductionMetaChanged" />
                                    <WrapPanel Margin="0,0,0,8">
                                        <ui:Button Content="Alege logo..." Click="OnChooseLogoClicked" Margin="0,0,6,0" />
                                        <ui:Button Content="Sterge" Appearance="Secondary" Click="OnClearLogoClicked" Margin="0,0,8,0" />
                                        <TextBlock x:Name="LogoPathText" Text="(niciun logo)" Foreground="Gray" FontSize="11" VerticalAlignment="Center" />
                                    </WrapPanel>
                                    <TextBlock Text="Sablon nume folder:" Margin="0,0,0,2" />
                                    <ui:TextBox x:Name="FolderTemplateBox" FontFamily="Consolas" Margin="0,0,0,2" TextChanged="OnProductionMetaChanged" />
                                    <TextBlock x:Name="FolderPreviewText" Foreground="Gray" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,2" />
                                    <TextBlock Text="{}{data}  {ora}  {proiect}  {card}  {camera}  {operator}"
                                               Foreground="Gray" FontFamily="Consolas" FontSize="10" Margin="0,0,0,12" />

                                    <TextBlock Text="I/O &amp; Memorie" FontWeight="Bold" Margin="0,0,0,6" />
                                    <WrapPanel Margin="0,0,0,8">
                                        <ui:Button x:Name="PresetEcoBtn" Content="Eco / Sistem Slab" Margin="0,0,4,4" Click="OnPresetClicked" />
                                        <ui:Button x:Name="PresetStandardBtn" Content="Standard" Margin="0,0,4,4" Click="OnPresetClicked" />
                                        <ui:Button x:Name="PresetHighBtn" Content="Performanta Inalta" Margin="0,0,4,4" Click="OnPresetClicked" />
                                        <ui:Button x:Name="PresetExtremeBtn" Content="Extrem / Productie RAW" Margin="0,0,0,4" Click="OnPresetClicked" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBlock Text="Buffer copiere:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                        <ComboBox x:Name="ChunkSizeCombo" Width="100" Margin="0,0,20,4" />
                                        <TextBlock Text="Limita RAM:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                        <ComboBox x:Name="RamLimitCombo" Width="120" Margin="0,0,0,4" />
                                    </WrapPanel>
                                    <TextBlock x:Name="IoUsageText" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

                                    <!-- Destinatie secundara Cloud, powered by Rclone (2026-08-30) -
                                         vezi CloudSyncService.cs. Foloseste ACELEASI conturi configurate
                                         in Cloud Manager-ul din Master Control Studio Pro (rclone.conf
                                         e global, nu izolat per aplicatie). -->
                                    <TextBlock Text="Destinație secundară Cloud (Rclone)" FontWeight="Bold" Margin="0,0,0,6" />
                                    <TextBlock x:Name="CloudUnavailableText" Foreground="Orange" FontSize="11" TextWrapping="Wrap"
                                               Text="Rclone nu e instalat — instalează-l din Master Control Studio Pro (Dependențe) ca să activezi urcarea automată."
                                               Visibility="Collapsed" Margin="0,0,0,8" />
                                    <WrapPanel x:Name="CloudRemotePanel" Margin="0,0,0,4">
                                        <TextBlock Text="Cont:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                        <ComboBox x:Name="CloudRemoteCombo" Width="150" Margin="0,0,20,4" SelectionChanged="OnCloudRemoteChanged" />
                                    </WrapPanel>
                                    <WrapPanel x:Name="CloudFolderPanel" Margin="0,0,0,4" Visibility="Collapsed">
                                        <TextBlock Text="Subfolder:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                        <ui:TextBox x:Name="CloudFolderBox" Width="220"
                                                    PlaceholderText="implicit: numele folderului de transfer" Margin="0,0,0,4" />
                                    </WrapPanel>
                                    <TextBlock x:Name="CloudHintText" Foreground="Gray" FontSize="10" TextWrapping="Wrap"
                                               Text="Fiecare fișier copiat local se urcă automat, în fundal, imediat după verificare."
                                               Visibility="Collapsed" Margin="0,0,0,12" />

                                    <TextBlock Text="Profile de transfer" FontWeight="Bold" Margin="0,0,0,6" />
                                    <WrapPanel Margin="0,0,0,8">
                                        <ComboBox x:Name="ProfilesCombo" Width="200" Margin="0,0,8,4" />
                                        <ui:Button Content="Incarca" Click="OnLoadProfileClicked" Margin="0,0,4,4" />
                                        <ui:Button Content="Sterge" Click="OnDeleteProfileClicked" Appearance="Secondary" Margin="0,0,0,4" />
                                    </WrapPanel>
                                    <ui:Button Content="Salveaza configuratia curenta ca profil..." Click="OnSaveProfileClicked" HorizontalAlignment="Left" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>

                    <!-- Feed de activitate stil terminal - vezi terminalActivityFeed (Mac). -->
                    <Border Background="#0A0A0A" CornerRadius="6" Padding="8" Height="140">
                        <ScrollViewer x:Name="ActivityScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ActivityList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#4CD964" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== DESTINATII ===================== -->
            <ui:CardExpander Grid.Column="4" Header="DESTINATII" IsExpanded="True"
                             AllowDrop="True" DragOver="OnDestinationsDragOver" Drop="OnDestinationsDrop">
                <StackPanel>
                    <ui:ListView x:Name="DestinationsList" Height="140" Margin="0,0,0,8"
                                 AllowDrop="True" DragOver="OnDestinationsDragOver" Drop="OnDestinationsDrop" />
                    <ui:Button Content="Adauga destinatie..." Icon="{ui:SymbolIcon FolderAdd24}" Click="OnAddDestinationClicked" HorizontalAlignment="Stretch" Margin="0,0,0,4" />
                    <ui:Button Content="Elimina selectia" Click="OnRemoveDestinationClicked" HorizontalAlignment="Stretch" Appearance="Secondary" />
                </StackPanel>
            </ui:CardExpander>
        </Grid>

        <!-- ===================== FOOTER ===================== -->
        <!-- Footer refacut responsiv (2026-08-28, raportat de Cristi:
             "sa nu se urce una peste alta") - status/butoane pe randuri
             SEPARATE (nu doua coloane Grid, care se taiau/iesau din
             fereastra la latimi mici), butoanele intr-un WrapPanel aliniat
             dreapta care trece pe randul urmator daca nu mai incape. -->
        <Grid Grid.Row="3" Margin="16,0,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ProgressBar x:Name="ProgressBar" Grid.Row="0" Height="6" Margin="0,0,0,6" Minimum="0" Maximum="100" />

            <StackPanel Grid.Row="1" Margin="0,0,0,6">
                <TextBlock x:Name="StatusText" Text="Gata de pornire" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
                <TextBlock x:Name="SpeedAndUsageText" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
                <TextBlock x:Name="VersionText" FontSize="10" Foreground="DimGray" Margin="0,2,0,0" />
                <CheckBox x:Name="AutoOpenDestCheck" Content="Deschide automat destinatia la final" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>

            <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
                <!-- Raportat lipsa la testul real (2026-08-28): "la sfarsit
                     nu-mi da optiunea sa deschid folderul destinatie" -
                     buton vizibil doar dupa un transfer finalizat. -->
                <ui:Button x:Name="OpenDestinationButton" Content="Deschide destinatia" Icon="{ui:SymbolIcon FolderOpen24}"
                           Click="OnOpenLastDestinationClicked" Visibility="Collapsed" Margin="0,0,6,4" />
                <ui:Button Content="Actualizari" Icon="{ui:SymbolIcon ArrowSync24}" Click="OnCheckUpdatesClicked" Margin="0,0,6,4" />
                <!-- Indicator global de dependinte (Regula 4, CLAUDE.md) - rosu doar daca
                     lipseste o dependinta OBLIGATORIE (vezi SystemDependencyChecker.cs);
                     detaliile + butonul de instalare sunt in fereastra Profil. -->
                <Ellipse x:Name="DependencyDot" Width="8" Height="8" Fill="MediumSeaGreen" Margin="0,0,4,4" VerticalAlignment="Center" />
                <ui:Button Content="Profil" Icon="{ui:SymbolIcon Person24}" Click="OnShowProfileClicked" Margin="0,0,6,4" />
                <ui:Button Content="Istoric" Icon="{ui:SymbolIcon History24}" Click="OnShowHistoryClicked" Margin="0,0,6,4" />
                <ui:Button x:Name="PauseButton" Content="Pauza" Click="OnPauseClicked" IsEnabled="False" Margin="0,0,6,4" />
                <ui:Button x:Name="CancelButton" Content="Anuleaza" Click="OnCancelClicked" IsEnabled="False" Appearance="Secondary" Margin="0,0,6,4" />
                <ui:Button x:Name="StartButton" Content="Start" Click="OnStartClicked" Appearance="Primary" Margin="0,0,0,4" />
            </WrapPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
