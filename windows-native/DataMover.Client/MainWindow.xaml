<ui:FluentWindow x:Class="DataMover.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="DataMover" Height="720" Width="1180" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <!--
      Rescriere WPF/Fluent (2026-08-28), la cererea explicita a lui Cristi
      dupa ce a vazut design-ul mult mai modern al variantei Mac (SwiftUI) -
      inlocuieste treptat ui/windows/app.py (Python/Tkinter, design
      "primitiv"). Structura oglindeste ContentView.swift (Mac): coloana
      Surse | zona centrala (proiect/card/optiuni/activitate) | coloana
      Destinatii, cu un footer de progres/actiuni comun. Vezi CLAUDE.md
      pentru roadmap-ul complet (ce mai lipseste fata de Mac).

      IMPORTANT: FluentWindow inlocuieste chrome-ul nativ Windows - un
      <ui:TitleBar> explicit e OBLIGATORIU, altfel fereastra ramane fixa,
      fara zona de drag/minimize/maximize/close (bug real, gasit deja pe
      GDCVaultWin - vezi Regula in CLAUDE.md-ul acelui repo).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="DataMover 2.6.0" />

        <!-- ===================== DISCURI DETECTATE ===================== -->
        <!-- Raportat de Cristi (2026-08-28, test real pe Windows/Parallels):
             "nu detecteaza sursele, nu se vad hard discurile, cardurile
             video" - lipsea complet, spre deosebire de Mac (grid de discuri
             in ContentView.swift). Lista se reimprospateaza periodic (vezi
             RefreshDrives), clic pe "+ Sursa"/"+ Destinatie" adauga direct
             litera de disc in lista corespunzatoare. -->
        <ui:CardExpander Grid.Row="1" Header="DISCURI DETECTATE" IsExpanded="True" Margin="16,8,16,0">
            <ItemsControl x:Name="DrivesList" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1C1C1C" CornerRadius="6" Padding="10" Margin="0,0,8,8" Width="180">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Image Source="{Binding IconSource}" Width="24" Height="24" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding FreeSpaceText}" Foreground="Gray" FontSize="11" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="+ Sursa" Tag="{Binding Path}" Click="OnAddDriveAsSourceClicked" Margin="0,0,6,0" Padding="6,2" FontSize="11" />
                                    <Button Content="+ Destinatie" Tag="{Binding Path}" Click="OnAddDriveAsDestinationClicked" Padding="6,2" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ui:CardExpander>

        <Grid Grid.Row="2" Margin="16,8,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="200" MaxWidth="380" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="260" MinWidth="200" MaxWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- ===================== SURSE ===================== -->
            <!-- AllowDrop pe intreg panoul (nu doar pe ListView) - trage un
                 folder din Explorer oriunde in caseta Surse. Raportat lipsa
                 la testul real pe Windows (2026-08-28). -->
            <ui:CardExpander Grid.Column="0" Header="SURSE" IsExpanded="True"
                             AllowDrop="True" DragOver="OnSourcesDragOver" Drop="OnSourcesDrop">
                <StackPanel>
                    <ui:ListView x:Name="SourcesList" Height="140" Margin="0,0,0,8"
                                 AllowDrop="True" DragOver="OnSourcesDragOver" Drop="OnSourcesDrop" />
                    <ui:Button Content="Adauga sursa..." Icon="{ui:SymbolIcon FolderAdd24}" Click="OnAddSourceClicked" HorizontalAlignment="Stretch" Margin="0,0,0,4" />
                    <ui:Button Content="Elimina selectia" Click="OnRemoveSourceClicked" HorizontalAlignment="Stretch" Appearance="Secondary" />
                </StackPanel>
            </ui:CardExpander>

            <!-- ===================== CENTRU ===================== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ui:CardControl Icon="{ui:SymbolIcon DocumentFolder24}" Margin="0,0,0,8">
                        <ui:CardControl.Header>
                            <!-- WrapPanel (2026-08-28, responsivitate) - la o fereastra ingusta,
                                 campurile trec pe randul urmator in loc sa se taie/suprapuna
                                 peste marginea cardului (raportat de Cristi). -->
                            <WrapPanel>
                                <TextBlock Text="Proiect:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ui:TextBox x:Name="ProjectBox" Width="130" Margin="0,0,16,4" />
                                <TextBlock Text="Card:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ui:TextBox x:Name="CardBox" Width="130" Margin="0,0,0,4" />
                            </WrapPanel>
                        </ui:CardControl.Header>
                    </ui:CardControl>

                    <ui:CardExpander Header="Optiuni de copiere" IsExpanded="True" Margin="0,0,0,8">
                        <StackPanel Margin="0,8,0,0">
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Text="Model verificare:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox x:Name="VerificationCombo" Width="160" Margin="0,0,0,4" />
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Text="Excluderi:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ui:TextBox x:Name="ExclusionsBox" Width="260" Text=".DS_Store, .tmp, Thumbs.db" Margin="0,0,0,4" />
                            </WrapPanel>
                            <CheckBox x:Name="SkipExistingCheck" Content="Sari peste fisiere identice deja existente" />
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardExpander Header="I/O &amp; Memorie" IsExpanded="True" Margin="0,0,0,8">
                        <StackPanel Margin="0,8,0,0">
                            <WrapPanel Margin="0,0,0,8">
                                <ui:Button x:Name="PresetEcoBtn" Content="Eco / Sistem Slab" Margin="0,0,4,4" Click="OnPresetClicked" />
                                <ui:Button x:Name="PresetStandardBtn" Content="Standard" Margin="0,0,4,4" Click="OnPresetClicked" />
                                <ui:Button x:Name="PresetHighBtn" Content="Performanta Inalta" Margin="0,0,4,4" Click="OnPresetClicked" />
                                <ui:Button x:Name="PresetExtremeBtn" Content="Extrem / Productie RAW" Margin="0,0,0,4" Click="OnPresetClicked" />
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Text="Buffer copiere:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox x:Name="ChunkSizeCombo" Width="100" Margin="0,0,20,4" />
                                <TextBlock Text="Limita RAM:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox x:Name="RamLimitCombo" Width="120" Margin="0,0,0,4" />
                            </WrapPanel>
                            <TextBlock x:Name="IoUsageText" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardExpander Header="Profile de transfer" Margin="0,0,0,8">
                        <StackPanel Margin="0,8,0,0">
                            <WrapPanel Margin="0,0,0,8">
                                <ComboBox x:Name="ProfilesCombo" Width="200" Margin="0,0,8,4" />
                                <ui:Button Content="Incarca" Click="OnLoadProfileClicked" Margin="0,0,4,4" />
                                <ui:Button Content="Sterge" Click="OnDeleteProfileClicked" Appearance="Secondary" Margin="0,0,0,4" />
                            </WrapPanel>
                            <ui:Button Content="Salveaza configuratia curenta ca profil..." Click="OnSaveProfileClicked" HorizontalAlignment="Left" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Feed de activitate stil terminal - vezi terminalActivityFeed (Mac). -->
                    <Border Background="#0A0A0A" CornerRadius="6" Padding="8" Height="140">
                        <ScrollViewer x:Name="ActivityScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ActivityList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#4CD964" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== DESTINATII ===================== -->
            <ui:CardExpander Grid.Column="4" Header="DESTINATII" IsExpanded="True"
                             AllowDrop="True" DragOver="OnDestinationsDragOver" Drop="OnDestinationsDrop">
                <StackPanel>
                    <ui:ListView x:Name="DestinationsList" Height="140" Margin="0,0,0,8"
                                 AllowDrop="True" DragOver="OnDestinationsDragOver" Drop="OnDestinationsDrop" />
                    <ui:Button Content="Adauga destinatie..." Icon="{ui:SymbolIcon FolderAdd24}" Click="OnAddDestinationClicked" HorizontalAlignment="Stretch" Margin="0,0,0,4" />
                    <ui:Button Content="Elimina selectia" Click="OnRemoveDestinationClicked" HorizontalAlignment="Stretch" Appearance="Secondary" />
                </StackPanel>
            </ui:CardExpander>
        </Grid>

        <!-- ===================== FOOTER ===================== -->
        <!-- Footer refacut responsiv (2026-08-28, raportat de Cristi:
             "sa nu se urce una peste alta") - status/butoane pe randuri
             SEPARATE (nu doua coloane Grid, care se taiau/iesau din
             fereastra la latimi mici), butoanele intr-un WrapPanel aliniat
             dreapta care trece pe randul urmator daca nu mai incape. -->
        <Grid Grid.Row="3" Margin="16,0,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ProgressBar x:Name="ProgressBar" Grid.Row="0" Height="6" Margin="0,0,0,6" Minimum="0" Maximum="100" />

            <StackPanel Grid.Row="1" Margin="0,0,0,6">
                <TextBlock x:Name="StatusText" Text="Gata de pornire" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
                <TextBlock x:Name="SpeedAndUsageText" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
                <TextBlock x:Name="VersionText" FontSize="10" Foreground="DimGray" Margin="0,2,0,0" />
                <CheckBox x:Name="AutoOpenDestCheck" Content="Deschide automat destinatia la final" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>

            <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
                <!-- Raportat lipsa la testul real (2026-08-28): "la sfarsit
                     nu-mi da optiunea sa deschid folderul destinatie" -
                     buton vizibil doar dupa un transfer finalizat. -->
                <ui:Button x:Name="OpenDestinationButton" Content="Deschide destinatia" Icon="{ui:SymbolIcon FolderOpen24}"
                           Click="OnOpenLastDestinationClicked" Visibility="Collapsed" Margin="0,0,6,4" />
                <ui:Button Content="Actualizari" Icon="{ui:SymbolIcon ArrowSync24}" Click="OnCheckUpdatesClicked" Margin="0,0,6,4" />
                <ui:Button Content="Profil" Icon="{ui:SymbolIcon Person24}" Click="OnShowProfileClicked" Margin="0,0,6,4" />
                <ui:Button Content="Istoric" Icon="{ui:SymbolIcon History24}" Click="OnShowHistoryClicked" Margin="0,0,6,4" />
                <ui:Button x:Name="PauseButton" Content="Pauza" Click="OnPauseClicked" IsEnabled="False" Margin="0,0,6,4" />
                <ui:Button x:Name="CancelButton" Content="Anuleaza" Click="OnCancelClicked" IsEnabled="False" Appearance="Secondary" Margin="0,0,6,4" />
                <ui:Button x:Name="StartButton" Content="Start" Click="OnStartClicked" Appearance="Primary" Margin="0,0,0,4" />
            </WrapPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
