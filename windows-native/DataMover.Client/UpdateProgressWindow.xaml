<Window x:Class="DataMover.Client.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualizare DataMover" Width="360" Height="120"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="ToolWindow" Topmost="True">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock x:Name="StatusLabel" Text="Se pregătește actualizarea…" FontSize="13" Margin="0,0,0,12" TextWrapping="Wrap" />
        <ProgressBar IsIndeterminate="True" Height="6" />
    </StackPanel>
</Window>
