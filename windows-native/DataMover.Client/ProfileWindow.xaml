<ui:FluentWindow x:Class="DataMover.Client.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Profil &amp; Licență" Width="420" Height="560" MinWidth="360" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <!--
      Profil Utilizator/HWID + Licentiere + indicator dependinte
      (2026-08-28, cerut de Cristi) - port al blocului "Profil" din
      sidebar-ul Mac/GDCVaultWin, intr-o fereastra separata (clientul WPF
      nu are inca un sidebar permanent ca GDCVault) - vezi CLAUDE.md
      Partea 1, Regula 12.
    -->
    <ui:FluentWindow.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Profil &amp; Licență" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <TextBlock Text="Dependințe sistem" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                <ItemsControl x:Name="DependencyList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding StatusColor}" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="18,4,0,0" />
                                    <ui:Button Content="Instalează" Tag="{Binding DownloadUrl}" Click="OnInstallDependencyClicked"
                                               Visibility="{Binding NeedsInstallVisibility}" Margin="18,6,0,0" HorizontalAlignment="Left" FontSize="11" Padding="8,2" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button Content="Reverifică" Click="OnRecheckDependenciesClicked" HorizontalAlignment="Left" Appearance="Secondary" Margin="0,0,0,4" />

                <TextBlock Text="Profil utilizator" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="Nume (opțional):" Margin="0,0,0,4" />
                <ui:TextBox x:Name="NameBox" Margin="0,0,0,8" />
                <TextBlock Text="Email (opțional):" Margin="0,0,0,4" />
                <ui:TextBox x:Name="EmailBox" Margin="0,0,0,8" />
                <TextBlock Text="Machine ID:" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:TextBox x:Name="MachineIdBox" IsReadOnly="True" Width="220" Margin="0,0,8,0" />
                    <ui:Button Content="Copiază" Click="OnCopyMachineIdClicked" />
                </StackPanel>
                <ui:Button Content="Salvează profilul" Click="OnSaveProfileClicked" HorizontalAlignment="Left" />

                <TextBlock Text="Licență" Style="{StaticResource SectionHeader}" />
                <TextBlock x:Name="LicenseStatusText" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ui:TextBox x:Name="ActivationCodeBox" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Activează" Click="OnActivateClicked" Margin="0,0,8,0" />
                    <ui:Button Content="Cere cod pe WhatsApp" Click="OnRequestCodeClicked" Appearance="Secondary" />
                </StackPanel>

                <TextBlock Text="Aspect" Style="{StaticResource SectionHeader}" />
                <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Left" Width="160" Margin="0,0,0,8"
                          SelectionChanged="OnThemeChanged">
                    <ComboBoxItem Content="Sistem" Tag="System" />
                    <ComboBoxItem Content="Luminos" Tag="Light" />
                    <ComboBoxItem Content="Întunecat" Tag="Dark" />
                </ComboBox>

                <TextBlock Text="Actualizări" Style="{StaticResource SectionHeader}" />
                <TextBlock x:Name="VersionInfoText" Margin="0,0,0,8" />
                <ui:Button Content="Caută actualizări" Click="OnCheckUpdatesClicked" HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
