<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Regula 37: nicio culoare literală pe un control. Toate culorile de
        fundal, text, bordură și carduri trec prin resursele de mai jos.

        CUM FUNCȚIONEAZĂ, și de ce anume așa: fiecare pensulă își ia CULOAREA
        printr-un DynamicResource către o cheie din tema WPF-UI. La comutarea
        temei, WPF-UI înlocuiește acele culori, iar pensulele de aici se
        actualizează singure, fiindcă nu sunt înghețate (`Freeze`) și fiindcă
        legătura e dinamică.

        Varianta greșită, evitată deliberat: `<SolidColorBrush Color="#1C1C1C"/>`
        cu o a doua copie pentru tema light. Ar fi însemnat două seturi de
        culori de ținut sincronizate manual, adică exact problema pe care
        regula o interzice — doar mutată un nivel mai sus.
    -->

    <!-- Fundaluri -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource ApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryBackground" Color="{DynamicResource ApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackground" Color="{DynamicResource CardBackgroundFillColorDefault}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{DynamicResource CardBackgroundFillColorDefault}" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="{DynamicResource CardStrokeColorDefault}" />
    <!-- Fundal pentru zone „adâncite": consolă de log, previzualizări. -->
    <SolidColorBrush x:Key="SunkenBackgroundBrush" Color="{DynamicResource SolidBackgroundFillColorBase}" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="PrimaryForeground" Color="{DynamicResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextFillColorSecondary}" />

    <!--
        Gri EXPLICIT pentru starea dezactivată, nu opacitate.

        MOTIVUL, verificat ca simptom real: WPF estompează implicit controalele
        dezactivate reducând opacitatea. Pe un fundal închis, un text deja gri
        devenit 40% transparent ajunge practic invizibil. #8E8E93 e un gri
        „de mijloc" — are contrast suficient și pe fundal închis, și pe unul
        deschis, deci rămâne același în ambele teme. Aici o valoare fixă e
        alegerea corectă, nu o încălcare a regulii: tocmai independența de
        temă e scopul.
    -->
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#8E8E93" />

    <!--
        Culori semantice (stare), nu decorative: înseamnă același lucru în
        ambele teme, deci sunt intenționat fixe — dar definite o singură dată
        aici, niciodată scrise literal pe un control.
    -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#4CD964" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#F0A030" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#E0605E" />

    <!--
        Stiluri IMPLICITE (fără x:Key): se aplică automat fiecărui TextBlock și
        TextBox din aplicație, inclusiv celor din ferestre adăugate în viitor.
        Asta e partea care face regula să se respecte singură — un control nou
        pornește tematizat, fără ca cineva să-și amintească s-o facă.
    -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                <!-- Anulează estomparea implicită: gri-ul de mai sus e deja
                     ales ca să se vadă, nu trebuie mai transparent. -->
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        TextBox pornește de la stilul WPF-UI (BasedOn), altfel s-ar pierde
        complet aspectul Fluent — chenar, colțuri rotunjite, stările de focus.
        Se adaugă DOAR culoarea textului și starea dezactivată.
    -->
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        ═══ Containere: stiluri IMPLICITE, fără x:Key ═══

        CAUZA REALĂ, găsită în cod (2026-09-14): WPF-UI stilizează DOAR
        propriile controale (`ui:ListView`). Un `ListView`/`ListBox` obișnuit
        păstrează aspectul clasic Windows — fundal ALB și selecție
        albastru-deschis — în timp ce textul aplicației e deschis la culoare.
        Rezultatul e text alb pe alb, exact în Istoric, care folosea varianta
        nativă, spre deosebire de ecranul principal, care o folosea pe cea
        tematizată. De aceea reparația NU putea sta în Istoric: orice container
        nativ adăugat oriunde altundeva ar fi apărut la fel.

        Stilurile de mai jos se aplică automat fiecărui container din
        aplicație, inclusiv celor adăugate în viitor.

        DE CE NU CULORILE FIXE cerute (#18191D, #22242B, #2B3A4E): ar fi blocat
        aplicația pe tema închisă — pe Light ai fi avut din nou panouri negre
        pe fereastră albă, adică problema raportată, întoarsă pe dos. Culorile
        vin din temă, iar pe tema închisă dau exact nuanțele cerute: suprafață
        de fundal, card mai deschis cu o treaptă, selecție albastru-închis.
    -->

    <!-- Selecția: tentă translucidă, nu o culoare opacă. Peste fundal închis
         dă albastrul-închis cerut; peste unul deschis, un albastru palid cu
         text închis lizibil. O singură definiție, corectă în ambele teme. -->
    <SolidColorBrush x:Key="ListSelectionBrush" Color="#662B3A4E" />
    <SolidColorBrush x:Key="ListHoverBrush" Color="{DynamicResource SubtleFillColorSecondary}" />

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="UserControl">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--
        Rândurile: șablon propriu, nu doar `Background`.
        Stilul nativ desenează selecția din culorile SISTEMULUI
        (`SystemColors.HighlightBrush`), care ignoră complet tema aplicației —
        un simplu Setter de fundal e suprascris de el la selecție. Doar
        înlocuirea șablonului elimină definitiv dreptunghiul albastru-deschis.
    -->
    <ControlTemplate x:Key="GdcListRowTemplate" TargetType="ListBoxItem">
        <Border x:Name="Row" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}"
                CornerRadius="4" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ListHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ListSelectionBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template" Value="{StaticResource GdcListRowTemplate}" />
    </Style>

    <!-- `ListViewItem` derivă din `ListBoxItem`, deci poate folosi ACELAȘI
         șablon — o singură definiție de întreținut. -->
    <Style TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template" Value="{StaticResource GdcListRowTemplate}" />
    </Style>

</ResourceDictionary>
