<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Permite dotnet restore/build sa rezolve TFM-ul windows si de pe
         macOS (verificare reala a C#-ului, nu doar citire de cod) - vezi
         acelasi comentariu in GDCVaultWin/GDCPluginManagerWin. Nu
         inlocuieste un test real pe Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DataMover.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Raport PDF (2026-08-28, TODO din etapa precedenta) - port al
         pdf_report.py (Python/reportlab). QuestPDF, licenta Community
         (gratuita, companii sub 1M USD venit anual - cazul acestui proiect). -->
    <PackageReference Include="QuestPDF" Version="2024.10.3" />

    <!-- Licentiere + Profil/HWID + verificare update.json (2026-08-28) -
         acelasi tipar ca GDCVaultWin/GDCPluginManagerWin, portat aici la
         cererea lui Cristi. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
